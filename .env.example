# Postgres-Verbindung (auf Dokploy: interner Hostname des Postgres-Services)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weinmacher

# Geheimer Schlüssel für Payload (Sessions/Tokens) – einmalig generieren, z. B. mit:
#   openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME

# Öffentliche URL der Website (in Produktion, z. B. https://weinmacher-multeau.de)
# NEXT_PUBLIC_SERVER_URL=https://weinmacher-multeau.de
